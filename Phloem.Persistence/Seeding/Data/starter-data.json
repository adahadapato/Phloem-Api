    { "kind": "NotAllowed", "name": "Anything flammable or explosive", "detail": "Including gas canisters, lighters and fireworks" },
    { "kind": "NotAllowed", "name": "Anything illegal in the sending or receiving country" },
    { "kind": "Restricted", "name": "Dried fish and dried meat", "detail": "Fully dried, sealed and labelled" },
    { "kind": "Restricted", "name": "Palm oil and other oils", "detail": "Sealed bottles, 1 litre or less each" },
