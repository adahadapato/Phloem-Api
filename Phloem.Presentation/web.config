<?xml version="1.0" encoding="utf-8"?>
<!--
  Production IIS configuration for Phloem on SmarterASP.NET.

  - Self-contained .NET 10 Windows executable.
  - ASP.NET Core Module V2 with in-process hosting.
  - Production environment.
  - Temporary IIS diagnostic logging disabled.
  - Sensitive directories protected from direct IIS access.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <aspNetCore
        processPath=".\Phloem.Presentation.exe"
        arguments=""
        stdoutLogEnabled="true"
        stdoutLogFile=".\logs\stdout"
        hostingModel="inprocess">

        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>

        <handlerSettings>
          <handlerSetting name="debugFile" value=".\logs\aspnetcore-debug.log" />
          <handlerSetting name="debugLevel" value="FILE,TRACE" />
        </handlerSettings>

      </aspNetCore>

      <security>
        <requestFiltering>
          <hiddenSegments>
            <add segment="private-uploads" />
            <add segment="App_Data" />
            <add segment="logs" />
          </hiddenSegments>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
