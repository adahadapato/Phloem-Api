<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS settings for Phloem on Windows hosting. "dotnet publish" fills in processPath / arguments.
  - Runs in-process with ASPNETCORE_ENVIRONMENT = Production.
  - private-uploads is hidden by IIS as well as by the app (defence in depth): documents are only served through
    signed /private-files links.
  - App_Data (data-protection keys) and logs are never served: only wwwroot is served by the app.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=""
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering>
          <hiddenSegments>
            <add segment="private-uploads" />
            <add segment="App_Data" />
            <add segment="logs" />
          </hiddenSegments>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
