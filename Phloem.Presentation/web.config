<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for Phloem on SmarterASP.NET.

  - Runs the self-contained .NET 10 Windows executable.
  - Uses ASP.NET Core Module V2 with in-process hosting.
  - Runs in the Production environment.
  - Enables stdout logging temporarily for troubleshooting.
  - Blocks direct IIS access to private-uploads, App_Data and logs....
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore"
             path="*"
             verb="*"
             modules="AspNetCoreModuleV2"
             resourceType="Unspecified" />
      </handlers>

      <aspNetCore
          processPath=".\Phloem.Presentation.exe"
          arguments=""
          stdoutLogEnabled="true"
          stdoutLogFile=".\logs\stdout"
          hostingModel="inprocess">

        <environmentVariables>
          <environmentVariable
              name="ASPNETCORE_ENVIRONMENT"
              value="Production" />
        </environmentVariables>

      </aspNetCore>

      <security>
        <requestFiltering>
          <hiddenSegments>
            <add segment="private-uploads" />
            <add segment="App_Data" />
            <add segment="logs" />
          </hiddenSegments>
        </requestFiltering>
      </security>

    </system.webServer>
  </location>
</configuration>
