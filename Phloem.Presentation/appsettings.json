{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/phloem-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true,
          "flushToDiskInterval": "00:00:01",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "Phloem.Api"
    }
  },
  "AppSettings": {
    "ApiBaseUrl": "https://adahadapato-003-site4.dtempurl.com",
    "WebsiteBaseUrl": "https://adahadapato-003-site4.dtempurl.com"
  },
  "OpenApi": {
    "Enabled": false,
    "Title": "Phloem API",
    "Version": "v1",
    "Description": "Phloem backend: food ordering and parcel shipping.",
    "DocumentPath": "/openapi/{documentName}.json",
    "UiPath": "swagger",
    "Contact": {
      "Name": "Enobong Adahada",
      "Email": "",
      "Url": "https://github.com/adahadapato"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "SeedData": {
    "AdminEmail": "enobong.adahada@gmail.com",
    "AdminPassword": "",
    "AdminFirstName": "Enobong",
    "AdminLastName": "Adahada",
    "AdminCountry": "UnitedKingdom",
    "StarterDataEnabled": true,
    "StarterDataPath": "Seeding/Data/starter-data.json"
  },
  "Identity": {
    "RequireConfirmedEmail": false,
    "AuthenticatorIssuer": "Phloem",
    "Password": {
      "RequiredLength": 8,
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireNonAlphanumeric": false,
      "RequiredUniqueChars": 1
    },
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "LockoutMinutes": 15,
      "AllowedForNewUsers": true
    },
    "Links": {
      "ConfirmEmailPath": "/confirm-email",
      "ResetPasswordPath": "/reset-password"
    }
  },
  "Jwt": {
    "Key": "",
    "Issuer": "Phloem-API",
    "Audience": "Phloem-Client",
    "ExpiryMinutes": 15,
    "RefreshTokenDays": 30,
    "TwoFactorChallengeMinutes": 5
  },
  "Email": {
    "FromName": "Phloem",
    "FromAddress": "no-reply@phloem.app",
    "ReplyTo": {
      "Support": "support@phloem.app",
      "Sellers": "sellers@phloem.app",
      "Shipping": "shipping@phloem.app"
    },
    "TeamInbox": "team@phloem.app",
    "Host": "localhost",
    "Port": 25,
    "Security": "None",
    "Username": "",
    "Password": ""
  },
  "DataProtection": {
    "ApplicationName": "Phloem",
    "KeysPath": "App_Data/keys"
  },
  "Storage": {
    "Provider": "Local",
    "Local": {
      "PublicRootPath": "wwwroot/uploads",
      "PrivateRootPath": "wwwroot/private-uploads",
      "PrivateDownloadPath": "/private-files",
      "SigningKey": ""
    }
  },
  "Images": {
    "MaxDishPhotoBytes": 10485760,
    "MaxSimpleImageBytes": 5242880,
    "SimpleImageMaxSide": 800,
    "WebpQuality": 82,
    "BlurThreshold": 60,
    "EnhanceDishPhotos": true
  },
  "Payments": {
    "TestPaymentsEnabled": true
  },
  "AllowedHosts": "*"
}