{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AppSettings": {
    "ApiBaseUrl": "https://api.phloem.app",
    "WebsiteBaseUrl": "https://phloem.app"
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Email": {
    "FromName": "Phloem",
    "FromAddress": "no-reply@phloem.app",
    "ReplyTo": {
      "Support": "support@phloem.app",
      "Sellers": "sellers@phloem.app",
      "Shipping": "shipping@phloem.app"
    },
    "TeamInbox": "team@phloem.app",
    "Host": "localhost",
    "Port": 25,
    "Security": "None",
    "Username": "",
    "Password": ""
  },
  "Storage": {
    "Provider": "Local",
    "Local": {
      "PublicRootPath": "wwwroot/uploads",
      "PrivateRootPath": "wwwroot/private-uploads",
      "PrivateDownloadPath": "/private-files",
      "SigningKey": ""
    }
  },
  "Images": {
    "MaxDishPhotoBytes": 10485760,
    "MaxSimpleImageBytes": 5242880,
    "SimpleImageMaxSide": 800,
    "WebpQuality": 82,
    "BlurThreshold": 60,
    "EnhanceDishPhotos": true
  },
  "AllowedHosts": "*"
}